{
  "name": "lipepool/lipepool",
  "description": "Sistema seguro de agendamento de serviços LipePool",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "LipePool\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LipePool\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src public bin tests templates -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
